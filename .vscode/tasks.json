{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure NDLR",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-DJUCE_DIR=/Applications/JUCE",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DBUILD_TESTING=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: build NDLR Standalone",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--config", "Debug",
                "--target", "NDLR_Standalone",
                "-j", "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure NDLR",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CTest: NDLR regression tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir", "${workspaceFolder}/build",
                "--output-on-failure",
                "-C", "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: build NDLR Standalone",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
